{
  "name": "combinewrt-packages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signed apk feed and package catalog for CombineWRT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
